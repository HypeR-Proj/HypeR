"""Developer entry point for the repo-managed HypeR workspace."""

import argparse
from pathlib import Path
import subprocess
import sys


def main():
    root = Path(__file__).resolve().parent.parent
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    commands.add_parser('sync')
    commands.add_parser('status')
    commands.add_parser('prepare')
    test = commands.add_parser('test')
    test.add_argument('component')
    build = commands.add_parser('make')
    build.add_argument('arguments', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.command == 'sync':
        subprocess.run(['repo', 'sync'], cwd=root, check=True)
    elif args.command == 'status':
        subprocess.run(['repo', 'status'], cwd=root, check=True)
    else:
        command = [sys.executable, str(root / 'build/project.py'), '--workspace', str(root), args.command]
        if args.command == 'test':
            command.append(args.component)
        elif args.command == 'make':
            command.extend(args.arguments)
        subprocess.run(command, cwd=root, check=True)


if __name__ == '__main__':
    main()
