{
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "format": "hyper.board.v1",
  "board": "qemu",
  "architecture": "aarch64",
  "boot": "qemu-direct",
  "disk": {
    "uuid": "09f8feba-c8e5-46df-bb97-ceba1c4f334b",
    "partitions": [
      {
        "label": "hyper-data",
        "size-mib": 1024,
        "filesystem": "fat",
        "content": "data"
      },
      {
        "label": "hyper-system",
        "size-mib": 64,
        "filesystem": "erofs",
        "content": "system"
      },
      {
        "label": "alpine",
        "size-mib": 2048,
        "image": "alpine-rootfs"
      }
    ]
  },
  "files": {
    "vm/alpine.itb": "alpine"
  },
  "virtual-machines": [
    {
      "name": "alpine",
      "image": "vm/alpine.itb",
      "autostart": false,
      "configuration": {
        "memory-bytes": 268435456,
        "vcpus": 2,
        "bootargs": "console=ttyAMA0 earlycon=pl011,mmio32,0x09000000 rdinit=/init loglevel=7 hyper.root=/dev/sda"
      },
      "network": {
        "network": "default",
        "mac": "02:48:59:00:00:01"
      },
      "disk": {
        "source": "PARTLABEL=alpine"
      }
    }
  ],
  "io-vm": {
    "runtime": "io-runtime",
    "name": "io",
    "image": "/vm/io.itb",
    "configuration": {
      "memory-bytes": 134217728,
      "vcpus": 1,
      "bootargs": "console=ttyAMA0 earlycon=pl011,mmio32,0x09000000 rdinit=/init loglevel=4 hyper.role=io hyper.mode=standby"
    },
    "io-device": {
      "profile": "virtio-mmio-scsi",
      "compatible": "virtio,mmio"
    },
    "network-device": {
      "profile": "virtio-mmio-net",
      "compatible": "virtio,mmio"
    },
    "networks": [
      {
        "name": "default",
        "bridge": "hbr0",
        "uplink": "eth0"
      }
    ]
  }
}
