  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "version": 1,
  "kernel": {
    "features": ["runtime-symbols"]
  },
  "boot": {
    "base": "default",
    "exclude": ["fs-fat"]
  },
  "system": {
    "base": "none",
    "include": [
      "cat",
      "component-manager",
      "componentctl",
      "console-raw-system",
      "free",
      "fs-backend-system",
      "fs-erofs-system",
      "io-runtime-system",
      "journalctl",
      "ls",
      "mount-system",
      "ps",
      "session-manager",
      "sh",
      "svc/bootstrap-retire",
      "svc/journal",
      "system-startup",
      "terminal-service"
    ]
  }
}
