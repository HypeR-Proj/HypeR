# Deterministic first-userspace process for the hypervisor boot integration.

export PATH=/usr/bin:/usr/sbin:/bin:/sbin
export HOME=/root
if [ "${1:-}" != root-mounted ]; then
    /bin/busybox mount -t proc proc /proc
    /bin/busybox mount -t sysfs sysfs /sys
    /bin/busybox mount -t devtmpfs devtmpfs /dev
fi

# Kernel diagnostics remain on the UART named by console=. The independent
# shell transport can use virtio without registering a second printk console.
console_transport=uart
read -r cmdline < /proc/cmdline
for argument in $cmdline; do
    case "$argument" in
        hyper.root=*) root_device=${argument#hyper.root=} ;;
        hyper.console=*) console_transport=${argument#hyper.console=} ;;
    esac
done
case "$console_transport" in
    uart|virtio) ;;
    *) echo "HypeR guest: unsupported console transport: $console_transport" >&2; exit 1 ;;
esac

# Board guests explicitly request a persistent root; standalone fixtures keep
# the same complete Alpine userspace in RAM without requiring an I/O VM.
if [ "${1:-}" != root-mounted ]; then
    if [ -n "${root_device:-}" ]; then
        for module in virtio_mmio virtio_scsi sd_mod ext4; do
            /bin/busybox modprobe "$module" || exit 1
        done
        attempts=0
        while [ ! -b "$root_device" ] && [ "$attempts" -lt 30 ]; do
            /bin/busybox sleep 1
            attempts=$((attempts + 1))
        done
        /bin/busybox mkdir -p /newroot
        /bin/busybox mount -t ext4 -o rw "$root_device" /newroot || exit 1
        for mountpoint in dev proc sys; do
            /bin/busybox mount --move /"$mountpoint" /newroot/"$mountpoint" || exit 1
        done
        exec /bin/busybox switch_root /newroot /init root-mounted
    fi
fi

# Start networking only after the final root is mounted. Keep DHCP alive for
# lease renewal, but never wait for a link or server before opening the shell.
/bin/busybox ip link set lo up
for module in virtio_mmio virtio_net; do
    /bin/busybox modprobe "$module" >/dev/null 2>&1 || :
done
/bin/busybox mkdir -p /run /var/log
for net in /sys/class/net/*; do
    [ -e "$net" ] || continue
    interface=${net##*/}
    [ "$interface" != lo ] || continue
    /bin/busybox ip link set dev "$interface" up || continue
    /bin/busybox udhcpc -f -i "$interface" -t 3 -T 3 -A 5 \
        -p "/run/udhcpc-$interface.pid" \
        </dev/null >"/var/log/udhcpc-$interface.log" 2>&1 &
done

# Select a concrete tty for the interactive shell: /dev/console cannot become
# its controlling terminal. A requested virtio console must be present; silently
# reverting to the UART would conceal a broken device or an invalid benchmark.
if [ "$console_transport" = virtio ]; then
    if ! /bin/busybox modprobe virtio_console; then
        echo "HypeR guest: cannot load virtio console driver" >&2
        exit 1
    fi
    attempts=0
    while [ ! -c /dev/hvc0 ] && [ "$attempts" -lt 10 ]; do
        /bin/busybox sleep 1
        attempts=$((attempts + 1))
    done
    if [ ! -c /dev/hvc0 ]; then
        echo "HypeR guest: requested virtio console is unavailable" >&2
        exit 1
    fi
    console=hvc0
    exec </dev/hvc0 >/dev/hvc0 2>&1
else
    read -r consoles < /sys/class/tty/console/active
    console=${consoles##* }
fi

echo "HypeR guest: /init reached"
echo "HypeR guest: Linux userspace is running"

# BusyBox init owns PID 1, reaps children, respawns the shell and handles the
# signals sent by ordinary poweroff/reboot.
cd "$HOME" || exit 1
cat > /etc/inittab <<EOF
$console::respawn:/bin/sh -c 'cd /root && exec /bin/sh -i'
::ctrlaltdel:/bin/busybox reboot
::shutdown:/bin/busybox sync
::shutdown:/bin/busybox umount -a -r
EOF
exec /bin/busybox init
